<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SIBERAKSI: Misi Akhir Hero Siber</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
:root{--navy:#123a8c;--royal:#1a5fe0;--cyan:#12d4f5;--gold:#ffd21f;--orange:#ff9a1f;--red:#ff4a5a;--green:#3ddc84;
 --font:"Baloo 2","Fredoka","Trebuchet MS","Comic Sans MS",Arial,sans-serif}
html{background:#19b6ee;min-height:100%}
html,body{margin:0;min-height:100vh}
body{color:var(--navy);font-family:var(--font);font-size:clamp(20px,2.3vw,28px);font-weight:700;line-height:1.4;
 background:#19b6ee url("data:image/webp;base64,") center/cover no-repeat fixed}
p,li,label,span,div{font-size:inherit}

/* TAJUK GAYA POSTER: kuning + garis biru tua */
h1,.cert-title{font-weight:800;line-height:1.1;color:#ffe44d;font-size:clamp(40px,6vw,76px);
 -webkit-text-stroke:.07em #173f9e;paint-order:stroke fill;
 text-shadow:0 .08em 0 #b8560f,0 .16em .22em rgba(23,63,158,.45)}
h2{font-weight:800;font-size:clamp(32px,4.4vw,54px);color:var(--royal);text-shadow:0 3px 0 #fff,0 6px 0 rgba(23,63,158,.18)}
h3{font-weight:800;font-size:clamp(26px,3.2vw,40px);color:var(--navy)}
.subtitle{font-size:clamp(22px,2.8vw,34px);color:var(--navy)}

/* BAR ATAS */
.topbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;
 margin:10px auto;max-width:1200px;padding:10px 20px 18px;border-radius:26px;border:4px solid var(--gold);color:#fff;
 font-size:clamp(20px,2.4vw,30px);
 background:repeating-linear-gradient(135deg,var(--gold) 0 12px,#173f9e 12px 24px) bottom/100% 8px no-repeat,
  radial-gradient(circle,rgba(18,212,245,.35) 0 3px,transparent 4px) 0 0/26px 26px,
  linear-gradient(180deg,#2a7ff0,#123a8c);
 box-shadow:0 7px 0 #0a2468,0 12px 22px rgba(10,50,130,.35)}
.pill{padding:.2em .9em;border-radius:999px;font-weight:800;color:#fff;border:3px solid var(--gold);
 background:linear-gradient(180deg,#2a6fe6,#123a8c);box-shadow:0 4px 0 #0a2468}

/* PANEL = BINGKAI AWAN */
.panel{position:relative;max-width:1200px;margin:clamp(10px,2vw,26px) auto;padding:7% 8% 10%;
 min-height:min(56vw,72vh);border:0;border-radius:0;box-shadow:none;color:var(--navy);
 background:url("data:image/webp;base64,") center/100% 100% no-repeat;
 filter:drop-shadow(0 12px 18px rgba(10,50,130,.35))}
.panel:before,.panel:after{display:none}

/* BUTANG */
.btn,button{font-family:var(--font);font-weight:800;font-size:clamp(22px,2.6vw,32px);padding:.5em 1.4em;border-radius:999px;cursor:pointer}
.btn{color:#fff;border:4px solid var(--gold);text-shadow:0 2px 0 #0a2468;
 background:linear-gradient(180deg,#3d9cff,#1a5fe0 55%,#123a8c);
 box-shadow:inset 0 3px 0 rgba(255,255,255,.35),0 6px 0 #0a2468,0 10px 16px rgba(8,48,128,.3)}
.btn.gold{color:#6a3600;text-shadow:none;border-color:#ff9a1f;background:linear-gradient(180deg,#fff58a,#ffd633 52%,#ffad24);box-shadow:inset 0 3px 0 rgba(255,255,255,.5),0 6px 0 #c87912}
.btn.green{color:#064a36;text-shadow:none;background:linear-gradient(180deg,#a4f77e,#4cda79 55%,#18ad77);box-shadow:inset 0 3px 0 rgba(255,255,255,.45),0 6px 0 #12825b}
.btn.red{background:linear-gradient(180deg,#ff9a91,#ff5a70 55%,#e03a6c);box-shadow:inset 0 3px 0 rgba(255,255,255,.35),0 6px 0 #a52c5b}
.btn.light{color:var(--navy);text-shadow:none;background:linear-gradient(180deg,#bff3ff,#59d8f2 55%,#2aa8e8);box-shadow:inset 0 3px 0 rgba(255,255,255,.5),0 6px 0 #0877b6}
.btn:hover{transform:translateY(-3px) scale(1.03);filter:brightness(1.07)}
.btn:active{transform:translateY(3px)}

/* KAD PETA & BELAJAR */
.map-card,.learn-card{padding:14px 18px;border-radius:24px;border:4px solid var(--gold);color:#fff;
 background:radial-gradient(circle,rgba(255,255,255,.2) 0 3px,transparent 4px) 0 0/24px 24px,linear-gradient(145deg,#2a8cf0,#123a8c);
 box-shadow:0 7px 0 #0a2468,0 10px 16px rgba(7,55,130,.3)}
.map-card:nth-child(4n+2),.learn-card:nth-child(4n+2){background:radial-gradient(circle,rgba(255,255,255,.2) 0 3px,transparent 4px) 0 0/24px 24px,linear-gradient(145deg,#2fdc9b,#0f8aa8)}
.map-card:nth-child(4n+3),.learn-card:nth-child(4n+3){background:radial-gradient(circle,rgba(255,255,255,.2) 0 3px,transparent 4px) 0 0/24px 24px,linear-gradient(145deg,#ffb142,#ee5d7a)}
.map-card:nth-child(4n+4),.learn-card:nth-child(4n+4){background:radial-gradient(circle,rgba(255,255,255,.2) 0 3px,transparent 4px) 0 0/24px 24px,linear-gradient(145deg,#a98ff8,#4a5fd0)}
.map-card strong,.learn-card b{font-size:clamp(24px,2.8vw,34px);color:#fff58a;text-shadow:0 2px 0 #0a2468}
.map-card small{font-size:clamp(18px,2.1vw,24px);color:#fff}

/* JAWAPAN */
.answer{font-family:var(--font);font-weight:800;font-size:clamp(22px,2.6vw,32px);padding:.6em 1.1em;border-radius:999px;border:4px solid var(--gold);color:#fff;text-align:left;
 text-shadow:0 2px 0 #0a2468;background:linear-gradient(180deg,#3d9cff,#1a5fe0 55%,#123a8c);
 box-shadow:inset 0 3px 0 rgba(255,255,255,.3),0 6px 0 #0a2468,0 9px 14px rgba(8,48,128,.28)}
.answer:nth-child(2){background:linear-gradient(180deg,#52e8c0,#17b4a0 55%,#0b7f95)}
.answer:nth-child(3){background:linear-gradient(180deg,#ffc15e,#ff8a4a 55%,#e0507a)}
.answer:nth-child(4){background:linear-gradient(180deg,#b9a2ff,#7b72f0 55%,#4658c8)}
.answer:hover{background:linear-gradient(180deg,#fff58a,#ffc13a);color:#6a3600;text-shadow:none;transform:translateY(-3px) scale(1.02)}

/* NOTA & MAKLUM BALAS */
.note{font-size:clamp(20px,2.4vw,30px);padding:12px 20px;border-radius:20px;border:3px solid var(--orange);color:#6a3600;
 background:linear-gradient(110deg,#ffe86a,#ffc03a);box-shadow:0 5px 0 #c87912}
.feedback{font-size:clamp(22px,2.6vw,32px);font-weight:800;padding:12px 20px;border-radius:20px;border:4px solid var(--gold);color:#fff;text-shadow:0 2px 0 rgba(0,0,0,.25)}
.feedback.good{background:linear-gradient(130deg,#39d97e,#16c4aa,#0b9fb0)}
.feedback.bad{background:linear-gradient(130deg,#ff8b78,#f45b79,#c94cb0)}
.reward{font-size:clamp(60px,10vw,120px);filter:drop-shadow(0 8px 5px rgba(23,64,120,.6))}

/* SIJIL: GAMBAR SIJIL + NAMA DI KOTAK */
.certificate{container-type:inline-size;position:relative;width:min(100%,1100px);aspect-ratio:3/2;margin:16px auto;padding:0;border:0;border-radius:24px;overflow:hidden;
 color:var(--navy);background:url("data:image/webp;base64,") center/100% 100% no-repeat;box-shadow:0 14px 30px rgba(10,50,130,.4)}
.certificate h2,.certificate .cert-title,.certificate p{display:none}
.cert-name{position:absolute;left:25.8%;top:38.9%;width:46%;height:8.8%;margin:0;padding:0 2%;display:flex;align-items:center;justify-content:center;
 border:0;background:transparent;color:var(--navy);font-family:var(--font);font-weight:800;font-size:4.2cqw;text-align:center;text-shadow:none;white-space:nowrap;overflow:hidden;-webkit-text-stroke:0}

/* BORANG */
input,select,textarea{font-family:var(--font);font-size:clamp(22px,2.6vw,32px);font-weight:800;padding:.4em .8em;color:var(--navy);background:#fff6c2;border:4px solid var(--orange);border-radius:18px}
::placeholder{color:#a8741a}
.footer{font-size:clamp(18px,2vw,24px);color:#fff;text-shadow:0 2px 0 #0a2468}

[hidden]{display:none!important}
:focus-visible{outline:4px solid #fff;outline-offset:3px}
.wrap{max-width:1200px;margin:0 auto;padding:12px}
.posterwrap{position:relative}
.poster{display:block;width:100%;border-radius:26px;border:4px solid #ffd21f;box-shadow:0 8px 0 #0a2468,0 14px 24px rgba(10,50,130,.35)}
.hot{position:absolute;background:transparent;border:0;padding:0;border-radius:999px;cursor:pointer}
.hot:hover{box-shadow:0 0 0 5px rgba(255,255,255,.8)}
.grid5{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-top:14px}
button.map-card{display:block;width:100%;text-align:left;cursor:pointer;font-family:var(--font)}
button.map-card strong{display:block}
button.map-card:disabled{filter:grayscale(.6) brightness(.92);cursor:not-allowed}
.answers{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin:14px 0}
.answer:disabled{filter:grayscale(.5) brightness(.9);cursor:not-allowed}
.answer.ok{background:linear-gradient(180deg,#a4f77e,#3ddc84 55%,#18ad77);color:#064a36;text-shadow:none;filter:none}
.row{display:flex;flex-wrap:wrap;gap:14px;margin-top:14px}
.panel h1,.panel h2{margin:0 0 8px}
.panel p{margin:0 0 8px}
.note,.feedback{margin-top:12px}
.nama{width:100%;max-width:640px;display:block;margin:12px 0}
.tengah{text-align:center}
.tengah .row{justify-content:center}
@media print{body{background:#fff!important}.row,.topbar{display:none!important}.certificate{box-shadow:none}}
</style>
</head>
<body>
<div class="wrap">

<section id="mula" class="screen">
 <div class="posterwrap">
  <img class="poster" src="data:image/webp;base64," alt="SIBERAKSI: Misi Akhir Hero Siber, peta lima misi">
  <button class="hot" id="hotMula" aria-label="Mula misi" style="left:33.4%;top:76%;width:33.4%;height:12.7%"></button>
  <button class="hot" id="hotPeta" aria-label="Lihat peta" style="left:69%;top:85.5%;width:19.4%;height:6.2%"></button>
 </div>
</section>

<section id="peta" class="screen" hidden>
 <div class="topbar"><span class="pill">Peta misi</span><span class="pill" id="pBintang1">Bintang 0</span></div>
 <div class="panel">
  <h2>Pilih misi anda</h2>
  <p>Selesaikan setiap misi untuk membuka misi seterusnya.</p>
  <div class="grid5" id="kad"></div>
  <div class="row"><button class="btn gold" id="btnMulaPeta">Mula misi</button></div>
 </div>
</section>

<section id="kuiz" class="screen" hidden>
 <div class="topbar"><span class="pill" id="pMisi"></span><span class="pill" id="pBintang2"></span><span class="pill" id="pSoalan"></span></div>
 <div class="panel">
  <h2 id="tMisi"></h2>
  <p id="tSoalan"></p>
  <div class="answers" id="jawapan"></div>
  <div class="feedback" id="fb" hidden></div>
  <div class="note" id="nota" hidden></div>
  <div class="row"><button class="btn" id="btnNext" hidden>Seterusnya</button></div>
 </div>
</section>

<section id="nama" class="screen" hidden>
 <div class="panel tengah">
  <h1>Tahniah!</h1>
  <h2>Anda Hero Siber</h2>
  <p>Semua lima misi sudah selesai. Taip nama anda untuk sijil.</p>
  <input id="nm" class="nama" type="text" maxlength="40" placeholder="Nur Aisyah binti Ahmad" autocomplete="off" style="margin-left:auto;margin-right:auto">
  <div class="feedback bad" id="ralat" hidden>Taip nama anda dahulu.</div>
  <div class="row"><button class="btn gold" id="btnSijil">Dapatkan sijil</button></div>
 </div>
</section>

<section id="sijil" class="screen" hidden>
 <div class="certificate"><div class="cert-name" id="certNama"></div></div>
 <div class="note tengah" id="certBintang"></div>
 <div class="row" style="justify-content:center">
  <button class="btn green" id="btnCetak">Cetak sijil</button>
  <button class="btn light" id="btnUlang">Main semula</button>
 </div>
</section>

</div>
<script>
const M=[
{n:'Kota Kata Laluan',q:[
 {t:'Kata laluan manakah yang paling selamat?',a:['123456','nama_saya','Hr0!Siber#27','password'],c:2,e:'Kata laluan kuat menggabungkan huruf besar, huruf kecil, nombor dan simbol.'},
 {t:'Dalam perkataan dikongsi, apakah jenis imbuhannya?',a:['Awalan di-','Akhiran -an','Apitan ke-an','Sisipan -el-'],c:0,e:'Dikongsi = di- + kongsi. Imbuhan di- berada di hadapan kata dasar, jadi ia awalan.'}]},
{n:'Hutan Mesej Ugutan',q:[
 {t:'Seseorang menghantar mesej kasar dan mengugut anda. Apakah tindakan terbaik?',a:['Balas dengan marah','Simpan bukti dan beritahu guru atau ibu bapa','Sebarkan mesej itu','Abaikan sahaja'],c:1,e:'Simpan tangkap skrin sebagai bukti dan beritahu orang dewasa yang dipercayai.'},
 {t:'Perkataan ugutan mempunyai imbuhan jenis apa?',a:['Awalan','Akhiran','Apitan','Sisipan'],c:1,e:'Ugutan = ugut + -an. Imbuhan -an berada di belakang kata dasar, jadi ia akhiran.'}]},
{n:'Jambatan Perpaduan',q:[
 {t:'Rakan anda dikecam dalam media sosial kerana berbeza budaya. Apa yang anda lakukan?',a:['Ikut mengecam','Tegur dengan sopan dan sokong rakan itu','Kongsi komen kasar itu','Padam akaun rakan'],c:1,e:'Hero siber menghormati perbezaan dan tidak menyebarkan kebencian.'},
 {t:'Perkataan perpaduan mempunyai imbuhan jenis apa?',a:['Awalan','Akhiran','Apitan','Sisipan'],c:2,e:'Perpaduan = per- + padu + -an. Imbuhan di hadapan dan di belakang kata dasar ialah apitan.'}]},
{n:'Gua Bunyi Tersembunyi',q:[
 {t:'Orang tidak dikenali menghantar pautan "Menang hadiah percuma!". Apa tindakan anda?',a:['Klik segera','Jangan klik, padam dan beritahu orang dewasa','Hantar kepada rakan','Isi nombor telefon'],c:1,e:'Pautan pelik boleh mencuri maklumat. Jangan klik dan beritahu orang dewasa.'},
 {t:'Yang manakah perkataan bersisipan?',a:['berlari','telunjuk','makanan','kepandaian'],c:1,e:'Telunjuk = t + -el- + unjuk. Imbuhan -el- berada di tengah kata dasar, jadi ia sisipan.'}]},
{n:'Istana Hero Siber',q:[
 {t:'Maklumat manakah yang tidak boleh dikongsi dalam talian?',a:['Warna kegemaran','Alamat rumah dan kata laluan','Nama makanan kegemaran','Hobi membaca'],c:1,e:'Alamat rumah dan kata laluan ialah maklumat peribadi yang mesti dirahsiakan.'},
 {t:'Perkataan keselamatan mempunyai imbuhan jenis apa?',a:['Awalan','Akhiran','Apitan','Sisipan'],c:2,e:'Keselamatan = ke- + selamat + -an. Itulah apitan.'}]}
];
const $=id=>document.getElementById(id);
const S={m:0,q:0,stars:0,done:0,first:true};
const JUM=M.reduce((a,x)=>a+x.q.length,0);
function show(id){document.querySelectorAll('.screen').forEach(s=>s.hidden=s.id!==id);window.scrollTo(0,0)}
function bintang(){const t='Bintang '+S.stars;$('pBintang1').textContent=t;$('pBintang2').textContent=t}
function renderPeta(){
 bintang();const k=$('kad');k.innerHTML='';
 M.forEach((x,i)=>{
  const b=document.createElement('button');b.className='map-card';
  const st=i<S.done?'Selesai':i===S.done?'Mula misi':'Terkunci';
  b.innerHTML='<strong>'+(i+1)+'. '+x.n+'</strong><small>'+st+'</small>';
  b.disabled=i!==S.done;b.onclick=()=>mulaMisi(i);k.appendChild(b);
 });
 show('peta');
}
function mulaMisi(i){S.m=i;S.q=0;muatSoalan()}
function muatSoalan(){
 const x=M[S.m],q=x.q[S.q];S.first=true;bintang();
 $('pMisi').textContent='Misi '+(S.m+1)+' daripada '+M.length;
 $('pSoalan').textContent='Soalan '+(S.q+1)+' daripada '+x.q.length;
 $('tMisi').textContent=x.n;$('tSoalan').textContent=q.t;
 $('fb').hidden=true;$('nota').hidden=true;$('btnNext').hidden=true;
 const o=q.a.map((t,i)=>({t,ok:i===q.c}));
 for(let i=o.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[o[i],o[j]]=[o[j],o[i]]}
 const w=$('jawapan');w.innerHTML='';
 o.forEach((p,i)=>{
  const b=document.createElement('button');b.className='answer';b.textContent=String.fromCharCode(65+i)+'. '+p.t;
  b.onclick=()=>jawab(b,p.ok,q);w.appendChild(b);
 });
 show('kuiz');
}
function jawab(b,ok,q){
 const fb=$('fb');fb.hidden=false;
 if(ok){
  const dapat=S.first&&S.done===S.m;
  if(dapat)S.stars++;bintang();
  document.querySelectorAll('#jawapan .answer').forEach(a=>a.disabled=true);
  b.classList.add('ok');
  fb.className='feedback good';fb.textContent=dapat?'Betul! Anda dapat 1 bintang.':'Betul!';
  $('nota').hidden=false;$('nota').textContent=q.e;
  $('btnNext').hidden=false;$('btnNext').focus();
 }else{
  S.first=false;b.disabled=true;
  fb.className='feedback bad';fb.textContent='Belum tepat. Cuba lagi!';
 }
}
$('btnNext').onclick=()=>{
 S.q++;
 if(S.q<M[S.m].q.length){muatSoalan();return}
 if(S.m===S.done)S.done++;
 if(S.done>=M.length){show('nama');$('nm').focus()}else renderPeta();
};
$('hotMula').onclick=()=>mulaMisi(Math.min(S.done,M.length-1));
$('hotPeta').onclick=renderPeta;
$('btnMulaPeta').onclick=()=>mulaMisi(Math.min(S.done,M.length-1));
$('nm').oninput=()=>{$('ralat').hidden=true};
$('btnSijil').onclick=()=>{
 const n=$('nm').value.trim();
 if(!n){$('ralat').hidden=false;$('nm').focus();return}
 $('certNama').textContent=n;
 $('certBintang').textContent='Bintang terkumpul: '+S.stars+' daripada '+JUM;
 show('sijil');
};
$('btnCetak').onclick=()=>window.print();
$('btnUlang').onclick=()=>{S.m=0;S.q=0;S.stars=0;S.done=0;$('nm').value='';show('mula')};
</script>
</body>
</html>
